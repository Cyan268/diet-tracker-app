# Non-secret configuration only. Copy outside Git; never use .local for production.
NUTRIPILOT_PROJECT_NAME=nutripilot-vps
NUTRIPILOT_APP_IMAGE=registry.example.com/nutripilot:vps-REPLACE_WITH_TESTED_SHA
NUTRIPILOT_RELEASE=REPLACE_WITH_TESTED_SHA
NUTRIPILOT_PUBLIC_HOST=diet.example.com
# Bare hostname enables Caddy automatic HTTPS. No CDN/LB is assumed.
NUTRIPILOT_SITE_ADDRESS=diet.example.com
NUTRIPILOT_BIND_ADDRESS=0.0.0.0
NUTRIPILOT_HTTP_PORT=80
NUTRIPILOT_HTTPS_PORT=443
# Check for host/Docker/VPN subnet conflicts before choosing this subnet.
NUTRIPILOT_EDGE_SUBNET=172.30.91.0/28
NUTRIPILOT_PROXY_IP=172.30.91.2
NUTRIPILOT_API_IP=172.30.91.3
# Root-owned 0700 parent; mounted files readable by the container UID (see README).
NUTRIPILOT_SECRETS_PATH=/etc/nutripilot/secrets
NUTRIPILOT_POSTGRES_IMAGE=postgres:17-alpine
NUTRIPILOT_REDIS_IMAGE=redis:7.4-alpine
NUTRIPILOT_CADDY_IMAGE=caddy:2.10.2-alpine
