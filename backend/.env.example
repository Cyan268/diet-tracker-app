NUTRIPILOT_ENVIRONMENT=development
NUTRIPILOT_DEBUG=true
NUTRIPILOT_DATABASE_URL=postgresql+psycopg://nutripilot:nutripilot@localhost:5432/nutripilot
NUTRIPILOT_DATABASE_ECHO=false
NUTRIPILOT_REDIS_URL=redis://localhost:6379/0
# 作品集公开部署建议关闭注册；认证限流生产环境启用后必须 FAIL_CLOSED=true。
NUTRIPILOT_PUBLIC_REGISTRATION_ENABLED=true
NUTRIPILOT_AUTH_PROTECTION_ENABLED=true
NUTRIPILOT_AUTH_PROTECTION_FAIL_CLOSED=false
NUTRIPILOT_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
NUTRIPILOT_AUTH_LOGIN_ATTEMPTS_PER_WINDOW=10
NUTRIPILOT_AUTH_REGISTER_ATTEMPTS_PER_WINDOW=5
NUTRIPILOT_AUTH_VISITOR_REQUESTS_PER_WINDOW=30
# 只有直接 TCP 对端位于这些网段时才读取 X-Forwarded-For；不要填 0.0.0.0/0。
NUTRIPILOT_TRUSTED_PROXY_CIDRS=[]
NUTRIPILOT_RATE_LIMIT_HMAC_SECRET=development-only-rate-limit-hmac-secret
# 共享演示账号保护。生产环境启用后必须设置 FAIL_CLOSED=true。
NUTRIPILOT_DEMO_PROTECTION_ENABLED=true
NUTRIPILOT_DEMO_PROTECTION_FAIL_CLOSED=false
NUTRIPILOT_DEMO_RATE_LIMIT_WINDOW_SECONDS=60
NUTRIPILOT_DEMO_WRITE_REQUESTS_PER_WINDOW=30
NUTRIPILOT_DEMO_AI_REQUESTS_PER_WINDOW=12
NUTRIPILOT_DEMO_MAX_LOGS=100
NUTRIPILOT_DEMO_MAX_PRIVATE_FOODS=10
NUTRIPILOT_DEMO_MAX_CONVERSATIONS=8
NUTRIPILOT_DEMO_MAX_MESSAGES_PER_CONVERSATION=40
# 设为 0 时关闭自动重置；启用后密码只能由部署平台注入，不能提交真实值。
NUTRIPILOT_DEMO_RESET_INTERVAL_MINUTES=0
NUTRIPILOT_DEMO_RESET_EMAIL=demo@nutripilot.example
NUTRIPILOT_DEMO_RESET_PASSWORD=
NUTRIPILOT_DEMO_RESET_LOCK_TTL_SECONDS=300
NUTRIPILOT_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:8082","http://127.0.0.1:8082","http://localhost:19006"]
NUTRIPILOT_ALLOWED_HOSTS=["localhost","127.0.0.1"]
NUTRIPILOT_LOG_LEVEL=INFO
NUTRIPILOT_LOG_FORMAT=json
# 可选：配置后发送未处理异常与采样性能事务；默认不发送 PII、Headers、Query 或请求正文。
NUTRIPILOT_SENTRY_DSN=
NUTRIPILOT_SENTRY_TRACES_SAMPLE_RATE=0
NUTRIPILOT_RELEASE=
NUTRIPILOT_JWT_SECRET=development-only-change-me-at-least-32-bytes
NUTRIPILOT_JWT_ISSUER=nutripilot-api
NUTRIPILOT_JWT_AUDIENCE=nutripilot-mobile
NUTRIPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=15
NUTRIPILOT_REFRESH_TOKEN_EXPIRE_DAYS=30
# 生产环境必须替换；用于加密用户自带的 AI API Key，不能提交真实值。
NUTRIPILOT_CREDENTIAL_ENCRYPTION_KEY=development-only-encryption-key-change-me-at-least-32-bytes
NUTRIPILOT_AI_PROVIDER=rule_based
NUTRIPILOT_OPENAI_API_KEY=
NUTRIPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
NUTRIPILOT_OPENAI_MODEL=gpt-5.6-luna
NUTRIPILOT_AI_TIMEOUT_SECONDS=8
NUTRIPILOT_AI_MAX_ATTEMPTS=2
NUTRIPILOT_AI_RETRY_DELAY_SECONDS=0.15
# 从当前官方价格页确认后再填写；留空时仍记录 Token，但成本标记为未定价。
NUTRIPILOT_AI_INPUT_PRICE_PER_MILLION_USD=
NUTRIPILOT_AI_OUTPUT_PRICE_PER_MILLION_USD=
