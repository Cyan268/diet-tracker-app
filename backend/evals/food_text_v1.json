{
  "dataset_schema_version": "2.0",
  "dataset_version": "food-text-zh-cn-v1.2.0",
  "description": "脱敏的中文饮食实体抽取评测集，覆盖多实体、中文数量、单位换算、餐次提示、未知食品、否定与非饮食意图。",
  "split": "test",
  "frozen": true,
  "source": "项目作者人工编写的合成饮食描述，不来自真实用户日志",
  "authorization": "作者自有合成数据，可用于本项目离线评测与公开复现",
  "annotators": ["project_author"],
  "annotation_protocol": "按文本显式内容标注实体、数量、单位和餐次；缺失数量使用自然份量并标记对应场景标签；争议标签在冻结前人工复核",
  "contains_personal_data": false,
  "grouping_policy": "同义改写或同一语义变体必须使用相同 group_id，且不得跨 development/test 切分；当前样本均为独立语义组",
  "evaluation_date": "2026-07-19",
  "locale": "zh-CN",
  "amount_absolute_tolerance": 0.000001,
