# 复制为部署平台的 Secret/Environment Variables，不要提交真实值。
NUTRIPILOT_ENVIRONMENT=production
NUTRIPILOT_DEBUG=false
NUTRIPILOT_DATABASE_URL=postgresql+psycopg://user:password@postgres.internal:5432/nutripilot
NUTRIPILOT_REDIS_URL=rediss://redis.internal:6379/0

# 使用密码管理器或部署平台生成的独立高熵值替换；三个密钥不得复用。
NUTRIPILOT_JWT_SECRET=<generate-at-least-32-random-characters>
NUTRIPILOT_CREDENTIAL_ENCRYPTION_KEY=<generate-at-least-32-random-characters>
NUTRIPILOT_RATE_LIMIT_HMAC_SECRET=<generate-at-least-32-random-characters>

# 作品集公开环境只提供可重置演示账号。
NUTRIPILOT_PUBLIC_REGISTRATION_ENABLED=false
NUTRIPILOT_AUTH_PROTECTION_ENABLED=true
NUTRIPILOT_AUTH_PROTECTION_FAIL_CLOSED=true
NUTRIPILOT_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
NUTRIPILOT_AUTH_LOGIN_ATTEMPTS_PER_WINDOW=10
NUTRIPILOT_AUTH_REGISTER_ATTEMPTS_PER_WINDOW=5
NUTRIPILOT_AUTH_VISITOR_REQUESTS_PER_WINDOW=30

# 必须替换为部署平台实际连接到 API 的代理/负载均衡器网段，禁止 0.0.0.0/0。
NUTRIPILOT_TRUSTED_PROXY_CIDRS=["10.0.0.0/8"]
NUTRIPILOT_ALLOWED_HOSTS=["api.example.com"]
NUTRIPILOT_CORS_ORIGINS=["https://app.example.com"]

NUTRIPILOT_DEMO_PROTECTION_ENABLED=true
NUTRIPILOT_DEMO_PROTECTION_FAIL_CLOSED=true
NUTRIPILOT_DEMO_RATE_LIMIT_WINDOW_SECONDS=60
NUTRIPILOT_DEMO_WRITE_REQUESTS_PER_WINDOW=30
NUTRIPILOT_DEMO_AI_REQUESTS_PER_WINDOW=12
NUTRIPILOT_DEMO_MAX_LOGS=100
NUTRIPILOT_DEMO_MAX_PRIVATE_FOODS=10
NUTRIPILOT_DEMO_MAX_CONVERSATIONS=8
NUTRIPILOT_DEMO_MAX_MESSAGES_PER_CONVERSATION=40
NUTRIPILOT_DEMO_RESET_INTERVAL_MINUTES=0
NUTRIPILOT_DEMO_RESET_EMAIL=demo@nutripilot.example
NUTRIPILOT_DEMO_RESET_PASSWORD=
NUTRIPILOT_DEMO_RESET_LOCK_TTL_SECONDS=300

NUTRIPILOT_LOG_LEVEL=INFO
NUTRIPILOT_LOG_FORMAT=json
NUTRIPILOT_SENTRY_DSN=
NUTRIPILOT_SENTRY_TRACES_SAMPLE_RATE=0
NUTRIPILOT_RELEASE=

NUTRIPILOT_AI_PROVIDER=rule_based
NUTRIPILOT_OPENAI_API_KEY=
