ARG NODE_IMAGE=node:22-alpine
ARG PYTHON_IMAGE=python:3.13-slim
ARG BUILD_REVISION=development
ARG SOURCE_REVISION=unknown
FROM ${NODE_IMAGE} AS web-build

WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci

COPY app ./app
COPY assets ./assets
COPY src ./src
COPY app.json metro.config.js tsconfig.json ./
RUN npm run web:build


FROM ${PYTHON_IMAGE} AS runtime

ARG BUILD_REVISION
ARG SOURCE_REVISION

LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
    io.nutripilot.release=${BUILD_REVISION}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NUTRIPILOT_WEB_DIST_DIR=/app/web \
    NUTRIPILOT_IMAGE_REVISION=${BUILD_REVISION}

WORKDIR /app

COPY backend/requirements-runtime.lock backend/alembic.ini ./
RUN pip install --upgrade pip \
    && pip install -r requirements-runtime.lock \
    && pip uninstall --yes setuptools \
    && pip check

COPY backend/app ./app
COPY backend/migrations ./migrations
COPY --from=web-build /src/dist ./web

RUN groupadd --system nutripilot && useradd --system --gid nutripilot nutripilot
USER nutripilot

EXPOSE 8000

FROM runtime AS vps
CMD ["python", "-m", "app.cli.serve_vps"]

# Keep this last target as the default for the existing Render deployment.
FROM runtime AS render
CMD ["sh", "-c", "python -m app.cli.production_preflight --portfolio --single-origin-web && alembic upgrade head && python -m app.cli.reset_demo --allow-production && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --no-proxy-headers"]
