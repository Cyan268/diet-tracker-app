{
  "name": "diet-tracker-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "web:serve": "node scripts/serve-web.mjs",
    "web:preview": "npm run web:build && npm run web:serve",
    "deploy:smoke": "node scripts/smoke-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:web:sqlite": "node scripts/start-web-sqlite-check.mjs",
    "api:types": "openapi-typescript backend/openapi.json -o src/api/generated/schema.ts && prettier --write src/api/generated/schema.ts",
    "api:types:check": "npm run api:types && git diff --exit-code -- src/api/generated/schema.ts",
    "load:test": "docker compose --profile loadtest run --rm loadtest run --summary-export=/results/postgres-local-baseline.json /scripts/api-baseline.js",
    "format": "prettier --write \"{app,src,__tests__}/**/*.{ts,tsx}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{app,src,__tests__}/**/*.{ts,tsx}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
